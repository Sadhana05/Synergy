# Supabase Configuration (for deployment functionality)
# Get these values from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Custom deployment endpoint
# VITE_DEPLOY_ENDPOINT=https://your-deployment-api.com/deploy

# Note: Copy this file to .env.local and fill in your actual values
# The deployment feature will work in demo mode without these values
